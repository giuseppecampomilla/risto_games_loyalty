# === CONFIGURAZIONE RISTO LOYALTY ===

# --- BACKEND (WordPress) ---
# URL base dell'API WordPress del cliente (senza slash finale)
WP_API_URL=https://tuosito.com/wp-json/risto-loyalty/v1
# Chiave segreta per le comunicazioni tra server (deve corrispondere a quella nel plugin WP)
API_SECRET_KEY=sk_customer_unique_key_here

# --- MULTIPLAYER SERVER (Node.js) ---
# Porta su cui girerà il server multiplayer
MULTIPLAYER_PORT=3000
# Stringa di connessione MongoDB
MONGO_URI=mongodb://mongodb:27017/multiplayerDB

# --- FRONTEND (React) ---
# URL pubblico del server multiplayer (es. http://ip-server:3000 o https://game.tuosito.com)
VITE_MULTIPLAYER_URL=http://localhost:3000
