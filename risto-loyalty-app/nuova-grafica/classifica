            <div class="text-center mb-12 relative z-10">
                <h1 class="text-display-lg font-headline font-bold text-on-surface tracking-tight mb-2">Hall of Fame
                </h1>
                <p class="text-on-surface-variant font-medium tracking-wide uppercase text-xs">Season 04 • The Electric
                    Afterglow</p>
            </div>
            <!-- Podiums -->
            <div class="flex items-end justify-center gap-4 max-w-lg mx-auto relative z-10">
                <!-- 2nd Place -->
