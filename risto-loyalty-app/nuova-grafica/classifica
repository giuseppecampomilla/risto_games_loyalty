                <div class="space-y-8 relative z-10">
                    <div class="flex gap-5">
                        <div
                            class="flex-shrink-0 w-12 h-12 bg-surface-container-high rounded-xl flex items-center justify-center border border-outline-variant/20 text-primary font-headline font-bold text-xl">
