        <!-- Catalog -->
        <a class="flex flex-col items-center justify-center text-neutral-600 hover:text-neutral-300 transition-all active:scale-90 duration-200"
            href="#">
            <span class="material-symbols-outlined text-2xl mb-1">sports_esports</span>
            <span class="font-['Manrope'] font-extrabold text-[10px] tracking-widest uppercase">Catalog</span>
        </a>
        <!-- Play -->
        <a class="flex flex-col items-center justify-center text-neutral-600 hover:text-neutral-300 transition-all active:scale-90 duration-200"
            href="#">
            <span class="material-symbols-outlined text-2xl mb-1">videogame_asset</span>
            <span class="font-['Manrope'] font-extrabold text-[10px] tracking-widest uppercase">Play</span>
        </a>
        <!-- Board (Active) -->
        <a class="flex flex-col items-center justify-center text-amber-400 drop-shadow-[0_0_12px_rgba(255,173,74,0.8)] scale-110 active:scale-90 duration-200"
            href="#">
            <span class="material-symbols-outlined text-2xl mb-1"
                style="font-variation-settings: 'FILL' 1;">leaderboard</span>
            <span class="font-['Manrope'] font-extrabold text-[10px] tracking-widest uppercase">Board</span>
        </a>
        <!-- Prizes -->
        <a class="flex flex-col items-center justify-center text-neutral-600 hover:text-neutral-300 transition-all active:scale-90 duration-200"
            href="#">
            <span class="material-symbols-outlined text-2xl mb-1">military_tech</span>
            <span class="font-['Manrope'] font-extrabold text-[10px] tracking-widest uppercase">Prizes</span>
        </a>
    </nav>
</body>

