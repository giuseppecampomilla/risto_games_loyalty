                        </div>
                    </div>
                </div>
                <!-- Prize 2: Medium -->
                <div
                    class="bg-surface-container-high rounded-lg p-5 border border-outline-variant/5 flex flex-col justify-between aspect-square">
                    <span class="material-symbols-outlined text-secondary text-3xl mb-4"
                        style="font-variation-settings: 'FILL' 1;">restaurant</span>
                    <div>
                        <h4 class="font-headline font-bold text-lg mb-1 leading-tight">Free Loaded Fries</h4>
                        <p class="text-outline text-[10px] font-bold uppercase tracking-widest">1,200 PTS</p>
                    </div>
                </div>
                <!-- Prize 3: Medium -->
                <div
                    class="bg-surface-container-high rounded-lg p-5 border border-outline-variant/5 flex flex-col justify-between aspect-square">
                    <span class="material-symbols-outlined text-primary text-3xl mb-4"
                        style="font-variation-settings: 'FILL' 1;">confirmation_number</span>
