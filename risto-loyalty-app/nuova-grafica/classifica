                            <h4 class="font-bold text-on-surface mb-1">Scan to Start</h4>
                            <p class="text-on-surface-variant text-sm leading-relaxed">Find the QR code on your table to
                                sync your session to the live leaderboard.</p>
                        </div>
                    </div>
                    <div class="flex gap-5">
                        <div
                            class="flex-shrink-0 w-12 h-12 bg-surface-container-high rounded-xl flex items-center justify-center border border-outline-variant/20 text-secondary font-headline font-bold text-xl">
