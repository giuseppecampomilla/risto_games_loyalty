    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .glow-primary {
            filter: drop-shadow(0 0 12px rgba(255, 173, 74, 0.4));
        }

        .glow-secondary {
            filter: drop-shadow(0 0 12px rgba(38, 254, 220, 0.4));
        }

        .glow-tertiary {
            filter: drop-shadow(0 0 12px rgba(197, 126, 255, 0.4));
