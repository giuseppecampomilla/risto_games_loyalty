            <!-- Bento Prizes -->
            <div class="grid grid-cols-2 gap-4">
                <!-- Prize 1: Large -->
                <div
                    class="col-span-2 relative bg-surface-container-low rounded-lg p-6 border border-outline-variant/10 overflow-hidden group">
                    <div
                        class="absolute top-0 right-0 w-48 h-full opacity-30 group-hover:opacity-50 transition-opacity">
