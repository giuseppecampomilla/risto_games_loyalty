                        <div
                            class="absolute -top-3 -right-3 bg-surface-container-highest p-1.5 rounded-full border border-outline-variant glow-primary">
                            <span class="material-symbols-outlined text-outline text-lg">military_tech</span>
                        </div>
                    </div>
                    <div
                        class="w-full h-24 bg-surface-container-high rounded-t-lg flex flex-col items-center justify-start pt-4 border-x border-t border-outline-variant/10">
                        <span class="text-on-surface font-headline font-bold text-lg">Alex.V</span>
                        <span class="text-outline text-[10px] font-bold uppercase tracking-widest">8,940</span>
                    </div>
                </div>
                <!-- 1st Place -->
                <div class="flex flex-col items-center flex-1 -translate-y-4">
                    <div class="relative mb-4">
                        <div class="absolute -inset-4 bg-primary/20 blur-2xl rounded-full"></div>
                        <div
                            class="relative w-28 h-28 rounded-xl overflow-hidden border-2 border-primary p-1 bg-surface-container-high active:scale-95 transition-transform">
                            <img class="w-full h-full object-cover rounded-lg"
                                data-alt="smiling young woman with high bun in vibrant urban lighting with purple and pink highlights"
                                src="https://lh3.googleusercontent.com/aida-public/AB6AXuCzM2tYT82TBDINo_b84SYGp2gEqLl5Vj2OdRDrcCMDjdEGEeAvTyGt59Ed8va6DTB3xMx1u5pErYbLAtbLZ-qdFy1k4fzZWVv3dhI6VodHcCkGydKk-iwjddzjxDjLuxfVje64WIJA0vEobtoDbbvuo0T4_FUKbovebnq2SDypydt8UYelNggyV2j4Cz4bibecOlhKntOfbm65FWk4XvNHTkMwGQSnRC2rSN4f9OKlA0UlY1iKjhoVnoYG0fLczMIZ86SLA6nKiA" />
                        </div>
                        <div
                            class="absolute -top-4 left-1/2 -translate-x-1/2 bg-primary text-on-primary p-2 rounded-full glow-primary">
                            <span class="material-symbols-outlined text-xl"
                                style="font-variation-settings: 'FILL' 1;">workspace_premium</span>
                        </div>
                    </div>
                    <div
                        class="w-full h-32 bg-primary/10 backdrop-blur-md rounded-t-xl flex flex-col items-center justify-start pt-4 border-x border-t border-primary/30">
                        <span class="text-primary font-headline font-black text-xl">Luna_9</span>
                        <span
