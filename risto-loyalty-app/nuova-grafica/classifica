                        <span class="text-on-surface font-headline font-bold text-base">Jax.D</span>
                        <span class="text-outline text-[10px] font-bold uppercase tracking-widest">7,210</span>
                    </div>
                </div>
            </div>
        </section>
        <!-- Prizes Grid -->
        <section class="px-6 space-y-6">
            <div class="flex items-center justify-between">
                <h2 class="text-headline-md font-headline font-bold tracking-tight">Active Prizes</h2>
                <span class="text-secondary text-xs font-bold font-headline tracking-widest uppercase">3 Days
