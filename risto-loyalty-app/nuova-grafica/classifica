        <div
            class="px-4 py-2 bg-surface-container-high rounded-full border border-outline-variant/20 flex items-center gap-2 active:scale-95 transition-transform cursor-pointer">
            <span class="material-symbols-outlined text-primary text-sm"
                style="font-variation-settings: 'FILL' 1;">stars</span>
            <span class="text-primary font-['Space_Grotesk'] font-bold tracking-tighter uppercase">1,250 PTS</span>
        </div>
    </header>
    <main class="pb-32">
        <!-- Hall of Fame Hero -->
